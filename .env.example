# Public Firebase web-app configuration (Firebase Console > Project settings).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Server-only Firebase Admin service-account values.
# Store private-key line breaks as escaped \n in Vercel environment settings.
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""
# Optional server-side bucket override; defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
FIREBASE_ADMIN_STORAGE_BUCKET=""
# Optional local-only alternative: set true to use Google ADC credentials
# from `gcloud auth application-default login` or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_ADMIN_USE_ADC="false"

# Public site origin, also used to build the payment return URL.
AUTH_URL="http://localhost:3000"

# Email delivery through Resend for password resets, contact messages, and
# newsletter signups. Verify the sender domain with Resend before production.
# Keep the API key server-side.
RESEND_API_KEY=""
EMAIL_FROM="Shringaar <accounts@example.com>"

# Optional newsletter signups through a Resend audience. Keep the API key
# server-side and provide the audience ID from your Resend account.
RESEND_AUDIENCE_ID=""

# Optional public storefront contact and social links. Only real business
# details should be configured; social URLs must use HTTPS.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_BUSINESS_HOURS=""
NEXT_PUBLIC_BUSINESS_ADDRESS=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_PINTEREST_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_WHATSAPP_URL=""

# Set the Firebase custom admin claim for an existing Firebase Auth user with
# `npm run firebase:admin:claim`.
ADMIN_EMAIL="admin@example.invalid"

# Guest checkout configuration. Cash on delivery is enabled unless set to false.
COD_ENABLED="true"

# UroPay TEST credentials. Keep both values server-side; never use NEXT_PUBLIC_.
# UroPay signs every server request with HMAC-SHA256 and requires the matching
# TEST API secret as well as the TEST API key.
UROPAY_TEST_API_KEY=""
UROPAY_TEST_API_SECRET=""

# Optional HTTPS URL on the same origin as AUTH_URL. Defaults to
# https://<AUTH_URL-host>/checkout/payment-result when AUTH_URL is HTTPS.
# Local HTTP origins cannot be used as UroPay return URLs.
UROPAY_RETURN_URL=""
